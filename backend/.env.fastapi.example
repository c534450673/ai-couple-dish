APP_ENV=local
SERVICE_NAME=ai-couple-dish-fastapi
RELEASE_SHA=dev
LOG_LEVEL=INFO
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_couple_dish
DB_USERNAME=root
DB_PASSWORD=<inject-at-runtime>
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<inject-at-runtime-or-leave-unset>
REDIS_DATABASE=0
JWT_SECRET=<inject-at-runtime-min-64-chars>
JWT_EXPIRATION=604800000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
FILE_UPLOAD_PATH=/tmp/uploads
